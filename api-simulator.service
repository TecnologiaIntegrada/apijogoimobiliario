[Unit]
Description=API Simulador de Jogo Imobiliário
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/system
Environment="PATH=/system/venv/bin"
ExecStart=/system/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

