# secrets.yaml.example
# IMPORTANTE: NÃO COMMITAR ESTE ARQUIVO COM DADOS REAIS!
# Copie para secrets.yaml e adicione ao .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
  namespace: apijogoimobiliario
type: Opaque
stringData:
  # Banco de dados
  DATABASE_URL: "postgresql://user:password@host:5432/dbname"
  DATABASE_PASSWORD: "sua-senha-aqui"
  
  # JWT/Auth
  JWT_SECRET: "seu-secret-jwt-aqui"
  API_KEY: "sua-api-key-aqui"
  
  # Outros
  REDIS_URL: "redis://host:6379"
  
# Para usar no deployment, adicione:
#   envFrom:
#   - secretRef:
#       name: api-secrets
